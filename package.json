{
    "name": "pasteleria-monorepo",
    "private": true,
    "workspaces": [
        "backend",
        "frontend"
    ],
    "scripts": {
        "dev:backend": "npm run dev --workspace=backend",
        "dev:frontend": "npm run dev --workspace=frontend",
        "dev:all": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"BACK,FRONT\" -c \"blue,magenta\""
    }
}